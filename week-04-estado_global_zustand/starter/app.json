      "backgroundColor": "#0d1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.bootcamp.clinicafertilidad"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0d1117"
      },
      "package": "dev.bootcamp.clinicafertilidad"
    },
    "newArchEnabled": true,
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
